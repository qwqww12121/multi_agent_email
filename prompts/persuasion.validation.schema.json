{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "model-role-fields-4.0"
    },
    "role": {
      "const": "persuasion"
    },
    "no_influence_reason": {
      "$ref": "#/$defs/claim",
      "description": "Supported explanation of an empty influence_attempts list, with a real passage supporting that reading."
    },
    "uncertainties": {
      "$ref": "#/$defs/claim",
      "description": "Unresolved issues limiting this role. Use supported findings when quotable; otherwise unknown/null/empty evidence. Use not_present/null/empty evidence if no relevant uncertainty is identified."
    },
    "influence_attempts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "$ref": "#/$defs/claim",
            "description": "Actual wording used to influence behavior; connect it to its intended action.",
            "allOf": [
              {
                "properties": {
                  "status": {
                    "enum": [
                      "observed",
                      "inferred"
                    ]
                  }
                }
              }
            ]
          },
          "mechanism": {
            "$ref": "#/$defs/claim",
            "description": "time_limit: time constraint; promised_benefit: gain; stated_loss: adverse outcome; authority_or_rule: authority or obligation; curiosity: withheld information; secrecy_or_process_restriction: limits on disclosure or verification; ordinary_reason: practical rationale; other: another supported mechanism; ambiguous: unresolved mechanism.",
            "allOf": [
              {
                "properties": {
                  "status": {
                    "enum": [
                      "observed",
                      "inferred"
                    ]
                  },
                  "value": {
                    "enum": [
                      "time_limit",
                      "promised_benefit",
                      "stated_loss",
                      "authority_or_rule",
                      "curiosity",
                      "secrecy_or_process_restriction",
                      "ordinary_reason",
                      "other",
                      "ambiguous"
                    ]
                  }
                }
              }
            ]
          },
          "linked_action": {
            "$ref": "#/$defs/claim",
            "description": "Behavior the expression is intended to encourage or discourage."
          },
          "promised_outcome": {
            "$ref": "#/$defs/claim",
            "description": "Benefit or favorable outcome the sender promises for compliance."
          },
          "stated_consequence": {
            "$ref": "#/$defs/claim",
            "description": "Consequence the sender claims will follow noncompliance."
          },
          "authority_or_basis": {
            "$ref": "#/$defs/claim",
            "description": "Person, organization, rule or rationale invoked as support; not verified authenticity."
          },
          "communication_restrictions": {
            "$ref": "#/$defs/claim",
            "description": "Stated restrictions on consultation, disclosure, verification or channels; do not infer restrictions from silence."
          }
        },
        "required": [
          "expression",
          "mechanism",
          "linked_action",
          "promised_outcome",
          "stated_consequence",
          "authority_or_basis",
          "communication_restrictions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "role",
    "no_influence_reason",
    "uncertainties",
    "influence_attempts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1600
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "not_present",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "current",
            "quoted",
            "signature",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "required": [
        "value",
        "status",
        "scope",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "subject",
            "sender",
            "body",
            "headers",
            "html_links",
            "attachment_metadata"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "field",
        "quote"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "influence_attempts": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "no_influence_reason": {
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "no_influence_reason": {
            "properties": {
              "status": {
                "const": "not_present"
              }
            }
          }
        }
      }
    }
  ]
}
