{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "model-role-fields-4.0"
    },
    "role": {
      "const": "purpose"
    },
    "main_topic": {
      "$ref": "#/$defs/claim",
      "description": "Main subject matter of the visible message."
    },
    "stated_purpose": {
      "$ref": "#/$defs/claim",
      "description": "Explicit reason the sender gives for contacting the recipient."
    },
    "intended_outcome": {
      "$ref": "#/$defs/claim",
      "description": "Response or state the message seeks to bring about; mark inferred if not explicit."
    },
    "direct_consequence": {
      "$ref": "#/$defs/claim",
      "description": "Immediate supported result of complying, keeping conditions explicit and avoiding speculative later harm."
    },
    "affected_objects_or_assets": {
      "$ref": "#/$defs/claim",
      "description": "Objects or assets directly involved; do not assume that involvement establishes risk."
    },
    "beneficiary_or_receiver": {
      "$ref": "#/$defs/claim",
      "description": "Who receives the requested item or directly benefits; real-world identity may remain unknown."
    },
    "subject_body_alignment": {
      "$ref": "#/$defs/claim",
      "description": "Relationship between supplied subject and body; cite both for a mismatch; unknown if subject is unavailable."
    },
    "uncertainties": {
      "$ref": "#/$defs/claim",
      "description": "Unresolved issues limiting this role. Use supported findings when quotable; otherwise unknown/null/empty evidence. Use not_present/null/empty evidence if no relevant uncertainty is identified."
    },
    "subject_terms": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim",
        "description": "Meaningful terms actually present in subject; do not invent a subject from body."
      },
      "description": "Meaningful terms actually present in subject; do not invent a subject from body."
    }
  },
  "required": [
    "schema_version",
    "role",
    "main_topic",
    "stated_purpose",
    "intended_outcome",
    "direct_consequence",
    "affected_objects_or_assets",
    "beneficiary_or_receiver",
    "subject_body_alignment",
    "uncertainties",
    "subject_terms"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1600
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "not_present",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "current",
            "quoted",
            "signature",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "required": [
        "value",
        "status",
        "scope",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "subject",
            "sender",
            "body",
            "headers",
            "html_links",
            "attachment_metadata"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "field",
        "quote"
      ],
      "additionalProperties": false
    }
  }
}
