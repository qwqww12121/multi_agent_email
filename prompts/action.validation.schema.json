{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "model-role-fields-4.0"
    },
    "role": {
      "const": "action"
    },
    "no_actions_reason": {
      "$ref": "#/$defs/claim",
      "description": "Supported explanation of an empty requested_actions list. Cite a passage supporting the reading; do not invent a no-action quotation."
    },
    "uncertainties": {
      "$ref": "#/$defs/claim",
      "description": "Unresolved issues limiting this role. Use supported findings when quotable; otherwise unknown/null/empty evidence. Use not_present/null/empty evidence if no relevant uncertainty is identified."
    },
    "visible_urls": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim",
        "description": "URL strings actually visible in supplied input; do not infer hidden destinations."
      },
      "description": "URL strings actually visible in supplied input; do not infer hidden destinations."
    },
    "attachment_mentions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim",
        "description": "Attachments mentioned in text or supplied metadata; their unseen contents remain unknown."
      },
      "description": "Attachments mentioned in text or supplied metadata; their unseen contents remain unknown."
    },
    "requested_actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "requester": {
            "$ref": "#/$defs/claim",
            "description": "Person or organization presented as making the request; not authenticated identity."
          },
          "actor": {
            "$ref": "#/$defs/claim",
            "description": "Person or group expected to carry out the action."
          },
          "action": {
            "$ref": "#/$defs/claim",
            "description": "Requested or described behavior; preserve negation and distinguish current, quoted and past actions.",
            "allOf": [
              {
                "properties": {
                  "status": {
                    "enum": [
                      "observed",
                      "inferred"
                    ]
                  }
                }
              }
            ]
          },
          "action_object": {
            "$ref": "#/$defs/claim",
            "description": "Object, information or asset on which the behavior operates."
          },
          "destination_or_recipient": {
            "$ref": "#/$defs/claim",
            "description": "Visible destination or recipient of the operation or its output."
          },
          "conditions": {
            "$ref": "#/$defs/claim",
            "description": "Stated timing, prerequisites or circumstances attached to the request."
          },
          "statement_status": {
            "$ref": "#/$defs/claim",
            "description": "Relationship of the action to the current message: active, historical, quoted, conditional, negated or ambiguous.",
            "allOf": [
              {
                "properties": {
                  "status": {
                    "enum": [
                      "observed",
                      "inferred"
                    ]
                  },
                  "value": {
                    "enum": [
                      "current_request",
                      "historical_description",
                      "quoted_request",
                      "conditional_request",
                      "negated_request",
                      "ambiguous"
                    ]
                  }
                }
              }
            ]
          }
        },
        "required": [
          "requester",
          "actor",
          "action",
          "action_object",
          "destination_or_recipient",
          "conditions",
          "statement_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "role",
    "no_actions_reason",
    "uncertainties",
    "visible_urls",
    "attachment_mentions",
    "requested_actions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1600
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "not_present",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "current",
            "quoted",
            "signature",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "required": [
        "value",
        "status",
        "scope",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "subject",
            "sender",
            "body",
            "headers",
            "html_links",
            "attachment_metadata"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "field",
        "quote"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requested_actions": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "no_actions_reason": {
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "no_actions_reason": {
            "properties": {
              "status": {
                "const": "not_present"
              }
            }
          }
        }
      }
    }
  ]
}
